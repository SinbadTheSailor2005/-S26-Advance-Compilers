language core;

// a constant function, specialized to Nat
fn Nat2Nat::const(f : fn(Nat) -> Nat) -> (fn(Nat) -> (fn(Nat) -> Nat)) {
  return fn(x : Nat) { return f; };
}

// addition of natural numbers
fn Nat::add(n : Nat) -> (fn(Nat) -> Nat) {
  return fn(m : Nat) {
    return Nat::rec(n, m, fn(i : Nat) {
      return fn(r : Nat) { return succ(r); }; });
  };
}

// multiplication of natural numbers
fn Nat::mul(n : Nat) -> (fn(Nat) -> Nat) {
  return fn(m : Nat) {
    return Nat::rec(n, 0, Nat2Nat::const(Nat::add(m)));
  };
}

// factorial via primitive recursion
fn factorial(n : Nat) -> Nat {
  return Nat::rec(n, 1, fn(i : Nat) {
    return fn(r : Nat) {
    return Nat::mul(r)(succ(i));  // r := r * (i + 1)
  }; });
}

fn main(n : Nat) -> Nat {
  return factorial(n);
}
// Ожидает функцию типа fn(Nat) -> Bool
fn applyToZero(callback : fn(Nat) -> Bool) -> Bool {
  return callback(0)
}

fn main(n : Nat) -> Bool {
  // ОШИБКА ЗДЕСЬ:
  // Мы передаем анонимную функцию, которая говорит "я принимаю Bool",
  // хотя applyToZero требует функцию, принимающую Nat.
  return applyToZero(fn(x : Bool) {
    return if x then false else true
  })
}




// Функция пытается уменьшить число на 1
fn safe_pred(n : Nat) -> Nat + Unit {
  return if Nat::iszero(n) then
    // 0 не имеет предшественника -> Возвращаем "Ошибку" (правую часть)
    inr(unit)
  else
    // n > 0 -> Возвращаем результат (левую часть)
    inl(Nat::pred(n))
}

fn main(n : Nat) -> Nat {
  return match safe_pred(n) {
      inl(val) => val
    | inr(u)   => 0
  }
}