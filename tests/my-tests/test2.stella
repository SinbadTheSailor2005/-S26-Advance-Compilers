language core;
extend with #variants, #unit-type;

type Color = <| red : Unit, green : Unit, blue : Unit |>

fn get_hex(c : Color) -> Nat {
  return match c {
      <| red   = u |> => 1
    | <| green = u |> => 2
    | <| blue  = u |> => 3
  }
}

fn main(n : Nat) -> Nat {
  return                     // <--- Сначала return
    let myColor = <| red = unit |> as Color in
    get_hex(myColor)         // <--- Результат let-выражения
}